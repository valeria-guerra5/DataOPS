# Copia este archivo a .env y completa con tus credenciales reales.
# .env NUNCA se sube al repositorio (ver .gitignore) — cero credenciales en Git.

# --- Neon (misma branch dev del Momento 1) -----------------------------------
NEON_DEV_DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/rueda_libre?sslmode=require

# --- Snowflake -----------------------------------------------------------------
# El "Account identifier" está en Snowsight -> tu perfil -> Account. No es tu
# nombre de usuario.
SNOWFLAKE_ACCOUNT=xxxxxxx-xxxxxxx
SNOWFLAKE_USER=tu_usuario
SNOWFLAKE_PASSWORD=tu_password
SNOWFLAKE_WAREHOUSE=WH_TALLER
SNOWFLAKE_DATABASE=RUEDA_LIBRE
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=DATAOPS_LOADER
