# Copia este archivo a .env y complétalo con tus credenciales de Snowflake.
# profiles.yml lee estas variables vía env_var() — dbt no lee .env directamente, así que
# hay que exportarlas al shell antes de invocar dbt:
#
#   set -a && source .env && set +a
#   uv run dbt deps --profiles-dir .
#   uv run dbt build --profiles-dir .

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DATAOPS_LOADER
SNOWFLAKE_WAREHOUSE=WH_DATAOPS
SNOWFLAKE_DATABASE=PARCH_AND_POSEY
SNOWFLAKE_SCHEMA=ANALYTICS