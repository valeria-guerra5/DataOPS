# Plantilla de profiles.yml — cópiala a profiles.yml (gitignored) junto al proyecto y
# NO la versiones con credenciales reales.
#
# dbt busca profiles.yml en ~/.dbt/ por defecto. Para mantenerlo junto al proyecto sin
# arriesgar un commit accidental, corre los comandos con:
#   uv run dbt <comando> --profiles-dir .
#
# Todos los valores se leen de variables de entorno con env_var() — nunca hay una
# credencial en texto plano en este archivo, ni siquiera en la copia local.
rueda_libre:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'DATAOPS_LOADER') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'WH_TALLER') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'RUEDA_LIBRE') }}"
      # Schema "de respaldo" para cualquier objeto sin +schema propio (no debería
      # aplicar a ningún modelo de este proyecto — ver macros/generate_schema_name.sql).
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'CORE') }}"
      threads: 4
      client_session_keep_alive: false
